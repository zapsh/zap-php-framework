{
  "name": "zapsh/zap-php-framework",
  "description": "zap php framework",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "z",
      "email": "z@zap.cn"
    }
  ],
  "require": {
    "php": ">=8.2.0",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-dom": "*",
    "ext-simplexml": "*"
  },
  "autoload": {
    "files": ["src/functions.php"],
    "psr-4": {
      "zap\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "monolog/monolog": "Allows more advanced logging with multiple handlers"
  }
}
